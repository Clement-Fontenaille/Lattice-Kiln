# Normalize line endings. Repo stores LF; Windows tooling may check out CRLF.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts - they run under WSL.
*.sh    text eol=lf

# PowerShell is fine either way; keep CRLF on Windows checkouts.
*.ps1   text eol=crlf

# Never touch these.
*.gguf        binary
*.safetensors binary
*.png         binary
*.jpg         binary
